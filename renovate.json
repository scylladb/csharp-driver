{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "90 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/setup-python"],
      "enabled": false
    }
  ]
}
