{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "master",
    "branch-3.22"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Update docs Python dependencies together, including transitive dependencies through lock file maintenance",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "docs/pyproject.toml",
        "docs/uv.lock"
      ],
      "rangeStrategy": "update-lockfile",
      "groupName": "docs",
      "lockFileMaintenance": {
        "enabled": true
      },
      "matchBaseBranches": [
        "master"
      ]
    },
    {
      "description": "Keep the docs Python requirement aligned with the documentation build environment",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "docs/pyproject.toml"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false,
      "matchBaseBranches": [
        "master"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "90 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/setup-python"],
      "enabled": false
    },
    {
      "description": "Allow only security updates on the 3.22 maintenance branch",
      "matchBaseBranches": ["branch-3.22"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
