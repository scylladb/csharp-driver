{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "master",
    "branch-3.22"
  ],
  "ignoreDeps": [
    "Microsoft.NET.Test.Sdk"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "90 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/setup-python"],
      "enabled": false
    },
    {
      "description": "Allow only security updates on the 3.22 maintenance branch",
      "matchBaseBranches": ["branch-3.22"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
